# Copy to .env and fill in. Never commit .env.

# Any model LangChain's init_chat_model understands, as provider:model.
MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=

# Or use Claude instead:
# MODEL=anthropic:claude-sonnet-5
# ANTHROPIC_API_KEY=

# false = harness allows everything (still logs). Used for the before/after attack test.
RULES_ENABLED=true

# permissive = prompt says "a separate system checks your actions" (default)
# policy     = the three rules written into the prompt as words
PROMPT_MODE=permissive
